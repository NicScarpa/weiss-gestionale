# Pre-commit hook: Secret Scan, Lint and Type Check

echo "Running pre-commit checks..."

# Secret scan (blocca commit di credenziali/chiavi)
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact || {
    echo "BLOCCATO: gitleaks ha rilevato possibili segreti nei file in staging."
    exit 1
  }
else
  echo ""
  echo "########################################################################"
  echo "#  RISCHIO: gitleaks NON e' installato, lo scan dei segreti e' SALTATO  #"
  echo "#                                                                      #"
  echo "#  Questo commit puo' contenere credenziali senza che nulla lo fermi.   #"
  echo "#  Installalo prima del prossimo commit:  brew install gitleaks         #"
  echo "#  Poi ricontrolla la history:  gitleaks detect --redact                #"
  echo "########################################################################"
  echo ""
fi

# Lint
npm run lint || exit 1

# Type check
npx tsc --noEmit || exit 1

echo "Pre-commit checks passed!"
