  @@unique([budgetId, accountId])
  @@index([budgetCategoryId])
  @@map("budget_lines")
}

model BudgetAlert {
  id              String          @id @default(cuid())
  budgetId        String          @map("budget_id")
  accountId       String?         @map("account_id")
  month           Int?
  alertType       BudgetAlertType @map("alert_type")
