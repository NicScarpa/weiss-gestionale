model AttendancePolicy {
  id                   String   @id @default(cuid())
  venueId              String   @unique @map("venue_id")
  geoFenceRadius       Int      @default(100) @map("geo_fence_radius")
  requireGeolocation   Boolean  @default(true) @map("require_geolocation")
  blockOutsideLocation Boolean  @default(false) @map("block_outside_location")
  earlyClockInMinutes  Int      @default(15) @map("early_clock_in_minutes")
  lateClockInMinutes   Int      @default(10) @map("late_clock_in_minutes")
  earlyClockOutMinutes Int      @default(5) @map("early_clock_out_minutes")
  lateClockOutMinutes  Int      @default(30) @map("late_clock_out_minutes")
  autoClockOutEnabled  Boolean  @default(true) @map("auto_clock_out_enabled")
  autoClockOutHours    Int      @default(12) @map("auto_clock_out_hours")
  requireBreakPunch    Boolean  @default(false) @map("require_break_punch")
  /// L'uscita richiede una nota: la traccia più economica del perché di una
  /// giornata anomala.
  requireExitNote      Boolean  @default(false) @map("require_exit_note")
  minBreakMinutes      Int      @default(30) @map("min_break_minutes")
  notifyOnAnomaly      Boolean  @default(true) @map("notify_on_anomaly")
  notifyManagerEmail   String?  @map("notify_manager_email")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  venue                Venue    @relation(fields: [venueId], references: [id])

  @@map("attendance_policies")
}

/// Regole con cui le timbrature grezze diventano ore riconosciute.
///
/// Da non confondere con AttendancePolicy, che è un'altra cosa: quella dice
/// *se* e *dove* si può timbrare (geofence, tolleranze, chiusura automatica) ed
/// è una per sede. Questa dice *quante ore ti conto*, ed è riusabile: un locale
/// può averne una, un dipendente part-time un'altra.
///
/// Gli orari sono minuti dalla mezzanotte italiana (0-1439) invece di @db.Time,
/// che è la fonte degli errori di fuso corretti ad agosto 2026. Quando la fine
/// giornata è minore o uguale all'inizio, la giornata scavalca la mezzanotte:
/// è il caso dei turni Weiss 06:00-03:00.
model TimekeepingPolicy {
  id                          String                     @id @default(cuid())
  venueId                     String                     @map("venue_id")
  name                        String
  isDefault                   Boolean                    @default(false) @map("is_default")
  isActive                    Boolean                    @default(true) @map("is_active")
  dayStartMinutes             Int                        @map("day_start_minutes")
  dayEndMinutes               Int                        @map("day_end_minutes")
  lunchStartMinutes           Int?                       @map("lunch_start_minutes")
  lunchEndMinutes             Int?                       @map("lunch_end_minutes")
  /// La giornata segue il turno pianificato invece della finestra fissa:
  /// l'anticipo non conta, il ritardo si arrotonda dall'inizio del turno,
  /// e le ore oltre la fine passano da una revisione umana.
  useShiftAsWindow            Boolean                    @default(false) @map("use_shift_as_window")
  /// Margine entro cui l'arrivo anticipato o l'uscita posticipata contano come lavoro.
  flexMinutes                 Int                        @default(0) @map("flex_minutes")
  /// Intervallo di arrotondamento dell'entrata, in minuti. 1 = nessun arrotondamento.
  roundingMinutes             Int                        @default(1) @map("rounding_minutes")
  /// Entro questi minuti dal confine dell'intervallo l'orario resta esatto.
  roundingToleranceMinutes    Int                        @default(0) @map("rounding_tolerance_minutes")
  /// Intervallo e tolleranza dell'uscita. Null = si usano quelli dell'entrata.
  roundingOutMinutes          Int?                       @map("rounding_out_minutes")
  roundingOutToleranceMinutes Int?                       @map("rounding_out_tolerance_minutes")
  /// Tetto giornaliero: le ore oltre non entrano nel conteggio.
  maxDailyMinutes             Int?                       @map("max_daily_minutes")
  /// Ore settimanali da contratto, per il confronto con le ore lavorate.
  contractWeeklyHours         Decimal?                   @map("contract_weekly_hours") @db.Decimal(4, 1)
  saturdayAsOvertime          Boolean                    @default(false) @map("saturday_as_overtime")
  blockSunday                 Boolean                    @default(false) @map("block_sunday")
  /// Si timbra una volta sola e la giornata vale le ore riconosciute.
  singlePunchMode             Boolean                    @default(false) @map("single_punch_mode")
  createdAt                   DateTime                   @default(now()) @map("created_at")
  updatedAt                   DateTime                   @updatedAt @map("updated_at")
  venue                       Venue                      @relation(fields: [venueId], references: [id])
  extraBreaks                 TimekeepingPolicyBreak[]
  users                       User[]
  workLocations               WorkLocation[]
  versions                    TimekeepingPolicyVersion[]

  @@index([venueId, isActive])
  @@map("timekeeping_policies")
}

/// Fotografia dei parametri di calcolo di una regola prima di una modifica
/// con decorrenza: i giorni precedenti alla decorrenza continuano a essere
/// calcolati con questi valori, così una modifica di ottobre non riscrive il
/// cartellino di agosto già consegnato al consulente. Solo storia: si crea
/// al salvataggio della modifica e non si tocca mai più.
model TimekeepingPolicyVersion {
  id                          String            @id @default(cuid())
  policyId                    String            @map("policy_id")
  /// Primo giorno in cui questi valori NON valgono più: la decorrenza della
  /// modifica che li ha sostituiti. I giorni precedenti usano questa versione.
  effectiveUntil              DateTime          @map("effective_until") @db.Date
  name                        String
  dayStartMinutes             Int               @map("day_start_minutes")
  dayEndMinutes               Int               @map("day_end_minutes")
  lunchStartMinutes           Int?              @map("lunch_start_minutes")
  lunchEndMinutes             Int?              @map("lunch_end_minutes")
  useShiftAsWindow            Boolean           @map("use_shift_as_window")
  flexMinutes                 Int               @map("flex_minutes")
  roundingMinutes             Int               @map("rounding_minutes")
  roundingToleranceMinutes    Int               @map("rounding_tolerance_minutes")
  roundingOutMinutes          Int?              @map("rounding_out_minutes")
  roundingOutToleranceMinutes Int?              @map("rounding_out_tolerance_minutes")
  maxDailyMinutes             Int?              @map("max_daily_minutes")
  contractWeeklyHours         Decimal?          @map("contract_weekly_hours") @db.Decimal(4, 1)
  saturdayAsOvertime          Boolean           @map("saturday_as_overtime")
  blockSunday                 Boolean           @map("block_sunday")
  singlePunchMode             Boolean           @map("single_punch_mode")
  /// Le pause aggiuntive congelate: [{name, startMinutes, endMinutes}].
  extraBreaks                 Json              @map("extra_breaks")
  createdAt                   DateTime          @default(now()) @map("created_at")
  policy                      TimekeepingPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId, effectiveUntil])
  @@map("timekeeping_policy_versions")
}

/// Luogo fisico in cui si timbra: Weiss Cafè, Villa Varda, le Casette.
///
/// Non è la sede contabile. `Venue` resta unica per decisione architetturale
/// (vedi src/lib/venue.ts) e continua a governare contabilità, cassa e
/// scadenzario; i luoghi servono solo alle presenze, ognuno con le proprie
/// coordinate e il proprio raggio. È il modo per distinguere dove ha lavorato
/// una persona senza toccare l'isolamento dei dati contabili.
model WorkLocation {
  id                   String                        @id @default(cuid())
  venueId              String                        @map("venue_id")
  name                 String
  address              String?
  latitude             Decimal?                      @db.Decimal(10, 8)
  longitude            Decimal?                      @db.Decimal(11, 8)
  /// Raggio entro cui la timbratura è considerata in sede.
  geofenceRadiusMeters Int                           @default(100) @map("geofence_radius_meters")
  isActive             Boolean                       @default(true) @map("is_active")
  /// Regola oraria del luogo: se presente prevale su quella del dipendente.
  timekeepingPolicyId  String?                       @map("timekeeping_policy_id")
  createdAt            DateTime                      @default(now()) @map("created_at")
  updatedAt            DateTime                      @updatedAt @map("updated_at")
  venue                Venue                         @relation(fields: [venueId], references: [id])
  timekeepingPolicy    TimekeepingPolicy?            @relation(fields: [timekeepingPolicyId], references: [id])
  assignments          WorkLocationAssignment[]
  attendanceRecords    AttendanceRecord[]
  correctionRequests   AttendanceCorrectionRequest[]

  @@index([venueId, isActive])
  @@map("work_locations")
}

/// Chi lavora dove, e con quale modalità di rilevazione.
///
/// La modalità sta sull'assegnazione e non sulla persona né sul luogo: lo
/// stesso dipendente può timbrare con il GPS al bar e dichiarare le ore per il
/// lavoro amministrativo.
model WorkLocationAssignment {
  id             String       @id @default(cuid())
  userId         String       @map("user_id")
  workLocationId String       @map("work_location_id")
  trackingMode   TrackingMode @default(GPS_GEOFENCE) @map("tracking_mode")
  assignedAt     DateTime     @default(now()) @map("assigned_at")
  /// Fine dell'assegnazione: valorizzata invece di cancellare la riga, così lo
  /// storico delle timbrature resta interpretabile.
  endedAt        DateTime?    @map("ended_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workLocation   WorkLocation @relation(fields: [workLocationId], references: [id], onDelete: Cascade)

  @@unique([userId, workLocationId])
  @@index([workLocationId, endedAt])
  @@map("work_location_assignments")
}

/// Pause non retribuite oltre alla pausa pranzo (es. pausa merenda).
model TimekeepingPolicyBreak {
  id           String            @id @default(cuid())
  policyId     String            @map("policy_id")
  name         String
  startMinutes Int               @map("start_minutes")
  endMinutes   Int               @map("end_minutes")
  createdAt    DateTime          @default(now()) @map("created_at")
  policy       TimekeepingPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@map("timekeeping_policy_breaks")
}

model AttendanceAnomaly {
  id                 String                        @id @default(cuid())
  userId             String                        @map("user_id")
  venueId            String                        @map("venue_id")
  recordId           String?                       @map("record_id")
  assignmentId       String?                       @map("assignment_id")
  anomalyType        AnomalyType                   @map("anomaly_type")
  status             AnomalyStatus                 @default(PENDING)
  date               DateTime                      @db.Date
  description        String?
  expectedValue      String?                       @map("expected_value")
  actualValue        String?                       @map("actual_value")
  differenceMinutes  Int?                          @map("difference_minutes")
  resolvedBy         String?                       @map("resolved_by")
  resolvedAt         DateTime?                     @map("resolved_at")
  resolutionNotes    String?                       @map("resolution_notes")
  hoursAffected      Decimal?                      @map("hours_affected") @db.Decimal(4, 2)
  costImpact         Decimal?                      @map("cost_impact") @db.Decimal(10, 2)
  createdAt          DateTime                      @default(now()) @map("created_at")
  updatedAt          DateTime                      @updatedAt @map("updated_at")
  assignment         ShiftAssignment?              @relation(fields: [assignmentId], references: [id])
  record             AttendanceRecord?             @relation(fields: [recordId], references: [id])
  user               User                          @relation(fields: [userId], references: [id])
  venue              Venue                         @relation(fields: [venueId], references: [id])
  correctionRequests AttendanceCorrectionRequest[]

  @@index([userId, date])
  @@index([venueId, status])
  @@map("attendance_anomalies")
}

/// Promemoria push di timbratura: "sono le 8:55, ricordati di timbrare".
///
/// Un cron li passa in rassegna e invia la notifica nell'ora giusta dei
/// giorni attivi, saltando chi ha già timbrato se così configurato.
model ClockReminder {
  id            String                   @id @default(cuid())
  venueId       String                   @map("venue_id")
  name          String
  punchType     PunchType                @map("punch_type")
  /// Orario dell'avviso, in minuti dalla mezzanotte italiana.
  timeMinutes   Int                      @map("time_minutes")
  /// Giorni attivi: 0 = domenica ... 6 = sabato.
  daysOfWeek    Int[]                    @map("days_of_week")
  skipIfPunched Boolean                  @default(true) @map("skip_if_punched")
  title         String
  body          String
  isActive      Boolean                  @default(true) @map("is_active")
  /// Ultima giornata italiana in cui è partito, per non inviarlo due volte.
  lastSentDate  DateTime?                @map("last_sent_date") @db.Date
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")
  venue         Venue                    @relation(fields: [venueId], references: [id])
  recipients    ClockReminderRecipient[]

  @@index([venueId, isActive])
  @@map("clock_reminders")
}

/// Destinatari scelti di un promemoria. Nessuna riga = tutto l'organico
/// con accesso al portale.
model ClockReminderRecipient {
  id         String        @id @default(cuid())
  reminderId String        @map("reminder_id")
  userId     String        @map("user_id")
  reminder   ClockReminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reminderId, userId])
  @@map("clock_reminder_recipients")
}

/// Comunicazione aziendale: bacheca del portale, con priorità e scadenza.
model Communication {
  id          String                @id @default(cuid())
  venueId     String                @map("venue_id")
  title       String
  message     String
  priority    CommunicationPriority @default(NORMAL)
  /// Data dell'evento di cui parla, se ce n'è una.
  eventDate   DateTime?             @map("event_date") @db.Date
  /// Oltre questa data non compare più nel portale. Null = non scade.
  expiresAt   DateTime?             @map("expires_at")
  /// Nomi dei ruoli destinatari. Vuoto = tutti.
  targetRoles String[]              @map("target_roles")
  createdById String                @map("created_by_id")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  venue       Venue                 @relation(fields: [venueId], references: [id])
  createdBy   User                  @relation("CommunicationsCreated", fields: [createdById], references: [id])
  reads       CommunicationRead[]

  @@index([venueId, expiresAt])
  @@map("communications")
}

/// Chi ha letto cosa: serve al portale per il pallino "non letto".
model CommunicationRead {
  id              String        @id @default(cuid())
  communicationId String        @map("communication_id")
  userId          String        @map("user_id")
  readAt          DateTime      @default(now()) @map("read_at")
  communication   Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  user            User          @relation("CommunicationReads", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communicationId, userId])
  @@map("communication_reads")
}

/// Richiesta di correzione delle timbrature, iniziata dal dipendente.
///
/// È il percorso per la dimenticanza — il caso normale — e per chi dichiara
/// le ore invece di timbrarle: il dipendente propone entrata e/o uscita di una
/// giornata, un responsabile approva, e l'approvazione genera le timbrature
/// manuali collegate.
model AttendanceCorrectionRequest {
  id                String                  @id @default(cuid())
  userId            String                  @map("user_id")
  venueId           String                  @map("venue_id")
  workLocationId    String?                 @map("work_location_id")
  date              DateTime                @db.Date
  /// Orari proposti: almeno uno dei due (lo impone la validazione).
  requestedClockIn  DateTime?               @map("requested_clock_in")
  requestedClockOut DateTime?               @map("requested_clock_out")
  reason            String
  status            CorrectionRequestStatus @default(PENDING)
  /// Anomalia che questa richiesta chiude, se esiste.
  anomalyId         String?                 @map("anomaly_id")
  reviewedById      String?                 @map("reviewed_by_id")
  reviewedAt        DateTime?               @map("reviewed_at")
  reviewNotes       String?                 @map("review_notes")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")
  user              User                    @relation("CorrectionRequestedBy", fields: [userId], references: [id], onDelete: Cascade)
  venue             Venue                   @relation(fields: [venueId], references: [id])
  workLocation      WorkLocation?           @relation(fields: [workLocationId], references: [id])
  anomaly           AttendanceAnomaly?      @relation(fields: [anomalyId], references: [id])
  reviewedBy        User?                   @relation("CorrectionReviewedBy", fields: [reviewedById], references: [id])
  records           AttendanceRecord[]

  @@index([venueId, status])
  @@index([userId, date])
  @@map("attendance_correction_requests")
}

model NotificationPreference {
  id                   String   @id @default(cuid())
  userId               String   @unique @map("user_id")
  pushEnabled          Boolean  @default(true) @map("push_enabled")
  emailEnabled         Boolean  @default(false) @map("email_enabled")
  newShiftPublished    Boolean  @default(true) @map("new_shift_published")
  shiftReminder        Boolean  @default(true) @map("shift_reminder")
  shiftReminderMinutes Int      @default(60) @map("shift_reminder_minutes")
  shiftSwapRequest     Boolean  @default(true) @map("shift_swap_request")
  anomalyCreated       Boolean  @default(true) @map("anomaly_created")
  anomalyResolved      Boolean  @default(true) @map("anomaly_resolved")
  correctionApproved   Boolean  @default(true) @map("correction_approved")
  correctionRejected   Boolean  @default(true) @map("correction_rejected")
  newCorrectionRequest Boolean  @default(true) @map("new_correction_request")
  clockReminder        Boolean  @default(true) @map("clock_reminder")
  companyCommunication Boolean  @default(true) @map("company_communication")
  leaveApproved        Boolean  @default(true) @map("leave_approved")
  leaveRejected        Boolean  @default(true) @map("leave_rejected")
  leaveReminder        Boolean  @default(true) @map("leave_reminder")
  newLeaveRequest      Boolean  @default(true) @map("new_leave_request")
  staffAnomaly         Boolean  @default(true) @map("staff_anomaly")
  newDocument          Boolean  @default(true) @map("new_document")
  createdAt            DateTime @default(now()) @map("created_at")
