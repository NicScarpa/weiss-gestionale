model CashFlowScenario {
  id                String           @id @default(cuid())
  forecastId        String           @map("forecast_id")
  nome              String
  descrizione       String?
  tipoAggiustamento String?          @map("tipo_aggiustamento")
  importiModificati Boolean          @default(false) @map("importi_modificati")
  dateModificate    Boolean          @default(false) @map("date_modificate")
  createdAt         DateTime         @default(now()) @map("created_at")
  forecast          CashFlowForecast @relation(fields: [forecastId], references: [id], onDelete: Restrict)

  @@map("cash_flow_scenarios")
}

model CashFlowAlert {
  id            String              @id @default(cuid())
  venueId       String              @map("venue_id")
  forecastId    String?             @map("forecast_id")
  tipo          CashFlowAlertType   @map("tipo")
  dataPrevista  DateTime            @map("data_prevista") @db.Date
  saldoPrevisto Decimal             @map("saldo_previsto") @db.Decimal(12, 2)
  soglia        Decimal?            @map("soglia") @db.Decimal(12, 2)
  messaggio     String?
  stato         CashFlowAlertStatus @default(ATTIVO) @map("stato")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  forecast      CashFlowForecast?   @relation(fields: [forecastId], references: [id])
  venue         Venue               @relation(fields: [venueId], references: [id])

  @@index([venueId, stato])
  @@map("cash_flow_alerts")
}

model ScheduleRule {
  id            String   @id @default(cuid())
  venueId       String   @map("venue_id")
  direzione     String // 'emessi' o 'ricevuti'
  tipoDocumento String?  @map("tipo_documento")
  tipoPagamento String?  @map("tipo_pagamento")
  azione        String   @default("crea_riconcilia_movimento")
  /// DEPRECATO: puntava al piano dei conti per un'interpretazione errata
  /// dell'azione. Il conto della regola è quello BANCARIO su cui creare il
  /// movimento (vedi bankAccountId). Rimuovere dopo la migrazione dei dati.
  contoId       String?  @map("conto_id")
  /// Conto bancario su cui generare il movimento quando la regola si applica
  bankAccountId String?  @map("bank_account_id")
  ordine        Int      @default(0)
  isActive      Boolean  @default(true) @map("is_active")
  createdById   String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  /// Centro di costo esplicito e opzionale della regola: se valorizzato,
  /// impone il centro sul movimento generato dalla regola (logica nel Task 6).
  costCenterId  String?  @map("cost_center_id")

  venue       Venue        @relation(fields: [venueId], references: [id])
  conto       Account?     @relation(fields: [contoId], references: [id])
  bankAccount BankAccount? @relation("ScheduleRuleBankAccount", fields: [bankAccountId], references: [id])
  createdBy   User?        @relation("ScheduleRuleCreatedBy", fields: [createdById], references: [id])
  costCenter  CostCenter?  @relation(fields: [costCenterId], references: [id], onDelete: Restrict)

  @@index([venueId, direzione, ordine])
  @@index([isActive])
  @@index([costCenterId])
  @@map("schedule_rules")
}

model InvitationToken {
  id            String    @id @default(cuid())
  token         String    @unique
  email         String?
  firstName     String?   @map("first_name")
  lastName      String?   @map("last_name")
  invitedById   String    @map("invited_by_id")
  expiresAt     DateTime  @map("expires_at")
  usedAt        DateTime? @map("used_at")
  createdUserId String?   @unique @map("created_user_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  isActive      Boolean   @default(true) @map("is_active")

  invitedBy   User  @relation("InvitedByUser", fields: [invitedById], references: [id])
  createdUser User? @relation("CreatedByInvitation", fields: [createdUserId], references: [id])

  @@index([token])
  @@index([email])
  @@map("invitation_tokens")
}

model EmployeeDocument {
  id               String           @id @default(cuid())
  userId           String           @map("user_id")
  category         DocumentCategory
  filename         String
  originalFilename String           @map("original_filename")
  contentType      String           @map("content_type")
  fileSize         Int              @map("file_size")
  period           String?
  periodLabel      String?          @map("period_label")
  description      String?
  uploadedByUserId String           @map("uploaded_by_user_id")
  uploadBatchId    String?          @map("upload_batch_id")
  createdAt        DateTime         @default(now()) @map("created_at")

  /// Pagina di cedolino il cui intestatario non è stato riconosciuto durante lo
  /// split del PDF bulk. Finché è true il documento è intestato all'admin che ha
  /// caricato il file (userId non è nullable) e va escluso dal portale dipendente:
  /// diventa un cedolino normale solo dopo PATCH /api/documents/[id]/assign.
  needsAssignment Boolean @default(false) @map("needs_assignment")
  /// Estratto del testo delle pagine non riconosciute, mostrato all'admin per
  /// capire di chi è il cedolino.
  unmatchedText   String? @map("unmatched_text")

  user       User @relation("EmployeeDocuments", fields: [userId], references: [id], onDelete: Cascade)
  uploadedBy User @relation("DocumentUploader", fields: [uploadedByUserId], references: [id])

  @@index([userId, category])
  @@index([userId, period])
  @@index([needsAssignment])
  @@map("employee_documents")
}

model AuditLog {
  id         String   @id @default(cuid())
  timestamp  DateTime @default(now())
  userId     String?  @map("user_id")
  action     String // CREATE, UPDATE, DELETE, LOGIN, PASSWORD_CHANGE
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  venueId    String?  @map("venue_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  venue      Venue?   @relation(fields: [venueId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId])
  @@index([venueId])
  @@index([timestamp])
  @@map("audit_logs")
}

/// Centro di costo del piano dei conti v4. Al più uno può avere isDefault
/// true (indice unico parziale in DDL, non esprimibile qui).
model CostCenter {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isDefault   Boolean  @default(false) @map("is_default")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  journalEntries JournalEntry[]
  dailyClosures  DailyClosure[]
  dailyExpenses  DailyExpense[]
  scheduleRules  ScheduleRule[]

  @@map("cost_centers")
}

