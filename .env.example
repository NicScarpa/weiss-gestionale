# Database PostgreSQL
# Ottieni una connection string da Supabase, Neon, o altro provider
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# NextAuth
# Genera con: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
AUTH_SECRET=""

# App
NEXT_PUBLIC_APP_NAME="Weiss Cafè Gestionale"
NEXT_PUBLIC_DEFAULT_VENUE_CODE="WEISS"

# Cron Jobs
# Genera con: openssl rand -base64 32
CRON_SECRET=""

# Upstash Redis (Rate Limiting)
# Crea un database su https://upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Sentry (Error Monitoring)
# Ottieni DSN da https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# Resend (Email Service)
# Ottieni API key da https://resend.com
RESEND_API_KEY=""
EMAIL_FROM="noreply@weisscafe.com"

# App URL (for CORS)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your_google_maps_api_key"

# Encryption Key
# Genera con: openssl rand -base64 32
ENCRYPTION_KEY="generate_with_openssl_rand_base64_32"

# Storage file caricati (cedolini, allegati)
# In produzione punta al volume persistente montato (es. /data/uploads)
UPLOAD_ROOT=
# Se valorizzate, i file vanno su Supabase Storage invece che su filesystem
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# Notifiche push (Web Push standard, VAPID)
# Genera la coppia con: npx web-push generate-vapid-keys
# La pubblica arriva anche al browser e non è un segreto; la privata resta al server.
# Senza queste, le notifiche restano solo nella campanella in-app.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:info@weisscafe.com"

# GoCardless Bank Account Data (Open Banking)
# Ottieni le credenziali da https://bankaccountdata.gocardless.com/
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=
